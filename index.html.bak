<!doctype html>
<html lang="hu">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Máriás Portál</title>
<script>
(function(){
  try{
    var p = JSON.parse(localStorage.getItem('mub-prefs')||'{}');
    document.documentElement.className = p.ts || 'ts-2';
  }catch(e){}
})();
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Public+Sans:ital,wght@0,400;0,500;0,600;0,700;1,500&family=IBM+Plex+Mono:wght@500;600&display=swap">
<style>
  :root{
    --bg:#FFFFFF; --surface:#FFFFFF; --surface-2:#F1F8F3; --ink:#1B211D; --ink-soft:#57635B;
    --border:#DAEADF; --accent:#128A46; --accent-strong:#0B5C2E; --accent-soft:#E3F5E9;
    --gold:#CC2936; --gold-soft:#FBE4E6; --danger:#9C3B3B; --danger-soft:#F3DEDA;
    --shadow:rgba(20,30,24,0.10); --focus:#128A46;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --bg:#121713; --surface:#1B221D; --surface-2:#212A23; --ink:#F1F5F2; --ink-soft:#B6C2BA;
      --border:#324037; --accent:#4FCB88; --accent-strong:#7FE0AA; --accent-soft:#1D3A28;
      --gold:#F0666D; --gold-soft:#3C2023; --danger:#E08A8A; --danger-soft:#3A2323;
      --shadow:rgba(0,0,0,0.5); --focus:#7FE0AA;
    }
  }
  *,*::before,*::after{box-sizing:border-box}
  html{font-size:116%}
  html.ts-1{font-size:100%}
  html.ts-2{font-size:116%}
  html.ts-3{font-size:132%}
  body{margin:0; background:var(--bg); color:var(--ink); font-family:"Public Sans",-apple-system,Segoe UI,Roboto,sans-serif; line-height:1.55}
  h1,h2,h3{font-family:"Fraunces",Georgia,serif; text-wrap:balance; margin:0}
  .num{font-family:"IBM Plex Mono",ui-monospace,monospace; font-variant-numeric:tabular-nums}
  a{color:var(--accent-strong)}
  button,input,select,textarea{font:inherit; color:inherit}
  button{cursor:pointer}
  :focus-visible{outline:3px solid var(--focus); outline-offset:2px}
  [hidden]{display:none !important}
  .wrap{max-width:860px; margin:0 auto; padding:1.4rem 1.1rem 4rem}
  header.top{border-bottom:1px solid var(--border); background:var(--surface)}
  .topbar{max-width:860px; margin:0 auto; padding:1rem 1.1rem; display:flex; align-items:center; gap:.7rem; flex-wrap:wrap}
  .brand-mark{width:2.4rem; height:2.4rem; border-radius:50%; background:linear-gradient(135deg,var(--gold),var(--accent)); color:#fff; display:flex; align-items:center; justify-content:center; font-family:"Fraunces",serif; font-weight:700; font-size:1.2rem; flex:none}
  .brand-name{font-size:1.1rem; font-weight:600}
  .brand-sub{font-size:.72rem; color:var(--ink-soft)}
  nav.mainnav{display:flex; gap:.3rem; flex-wrap:wrap; align-items:center; margin-left:auto}
  nav.mainnav a{text-decoration:none; color:var(--ink-soft); font-size:.85rem; font-weight:600; padding:.4rem .65rem; border-radius:999px}
  nav.mainnav a.active{background:var(--accent-soft); color:var(--accent-strong)}
  .toolbtn{border:1px solid var(--border); background:var(--surface-2); border-radius:999px; padding:.4rem .75rem; font-size:.85rem; font-weight:700; color:var(--ink); font-family:"IBM Plex Mono",monospace}
  .toolgroup{display:flex; gap:.25rem; align-items:center; margin-left:.4rem; padding-left:.6rem; border-left:1px solid var(--border)}
  h1.page-title{font-size:1.6rem; margin-bottom:.2rem}
  .rule{height:3px; width:3.2rem; background:var(--gold); border-radius:2px; margin:.4rem 0 1.3rem}
  .card{background:var(--surface); border:1px solid var(--border); border-radius:14px; padding:1.2rem}
  .stack{display:flex; flex-direction:column; gap:1rem}
  .field{display:flex; flex-direction:column; gap:.3rem; margin-bottom:.9rem}
  .field label{font-size:.85rem; font-weight:700; color:var(--ink-soft)}
  .field input, .field select, .field textarea{border:1px solid var(--border); background:var(--bg); border-radius:9px; padding:.6rem .75rem; font-size:1rem; width:100%}
  .row2{display:grid; grid-template-columns:1fr 1fr; gap:.8rem}
  @media (max-width:520px){.row2{grid-template-columns:1fr}}
  .btn{border:1px solid var(--accent); background:var(--accent); color:#fff; border-radius:999px; padding:.65rem 1.2rem; font-weight:700; font-size:.95rem}
  .btn.secondary{background:transparent; color:var(--accent-strong)}
  .btn.sm{padding:.4rem .85rem; font-size:.82rem}
  .btn.danger{border-color:var(--danger); background:var(--danger-soft); color:var(--danger)}
  .btn:disabled{opacity:.5; cursor:not-allowed}
  .meta{color:var(--ink-soft); font-size:.88rem}
  .badge{display:inline-block; font-size:.72rem; font-weight:700; padding:.15rem .55rem; border-radius:999px; background:var(--gold-soft); color:var(--gold); margin-left:.4rem}
  .eventcard{border:1px solid var(--border); border-left:5px solid var(--accent); border-radius:10px; padding:.9rem 1rem; margin-bottom:.7rem}
  .eventcard.closed{border-left-color:var(--border)}
  .eventcard .title{font-weight:700; font-size:1.05rem}
  .tabs{display:flex; gap:.3rem; flex-wrap:wrap; margin-bottom:1.2rem; border-bottom:1px solid var(--border); padding-bottom:.6rem}
  .tabs button{background:transparent; border:none; padding:.45rem .8rem; border-radius:999px; font-weight:700; font-size:.85rem; color:var(--ink-soft)}
  .tabs button.active{background:var(--accent-soft); color:var(--accent-strong)}
  table.list{width:100%; border-collapse:collapse; font-size:.9rem}
  table.list th, table.list td{text-align:left; padding:.5rem .5rem; border-bottom:1px solid var(--border)}
  .table-wrap{overflow-x:auto}
  .thumbgrid{display:grid; grid-template-columns:repeat(auto-fill,minmax(110px,1fr)); gap:.5rem; margin-top:.7rem}
  .thumbgrid .ph{position:relative; border-radius:8px; overflow:hidden; border:1px solid var(--border); aspect-ratio:1}
  .thumbgrid .ph img{width:100%; height:100%; object-fit:cover; display:block}
  .thumbgrid .ph .podiummark{position:absolute; top:4px; left:4px; background:var(--gold); color:#fff; font-size:.65rem; font-weight:700; padding:.1rem .4rem; border-radius:999px}
  .thumbgrid .ph .rm{position:absolute; bottom:4px; right:4px; background:rgba(0,0,0,.55); color:#fff; border:none; border-radius:999px; width:1.6rem; height:1.6rem; font-size:.8rem}
  .gallerygroup{margin-bottom:1.8rem}
  .gallerygroup .ghead{font-weight:700; margin-bottom:.3rem}
  .confirm{text-align:center; padding:2rem 1rem}
  .confirm .mark{width:4rem; height:4rem; border-radius:50%; background:var(--accent-soft); color:var(--accent-strong); display:flex; align-items:center; justify-content:center; margin:0 auto 1rem; font-size:2rem}
  .banner{border:1px solid var(--gold); background:var(--gold-soft); border-radius:10px; padding:.8rem 1rem; margin-bottom:1.2rem; font-size:.9rem}
  .footer-link{text-align:center; margin-top:2rem; font-size:.82rem; color:var(--ink-soft)}
  .footer-link a{color:var(--ink-soft); text-decoration:underline}
  .toolbar{display:flex; gap:.5rem; flex-wrap:wrap; align-items:center; justify-content:space-between; margin-bottom:1rem}
  @media print{
    header.top, .noprint{display:none !important}
    body{background:#fff}
    .wrap{max-width:100%; padding:0}
  }
  .checkbox{width:1.1rem; height:1.1rem; border:1.5px solid var(--ink-soft); display:inline-block}
  .cardstrip{height:34px; width:100%; display:block; background:var(--surface-2)}
  .radiorow{display:flex; gap:1.2rem; margin-bottom:.9rem}
  .radiorow label{display:flex; align-items:center; gap:.4rem; font-weight:600; font-size:.9rem}
  .sheetwrap{border:1px solid var(--border); border-radius:12px; overflow:hidden; margin-bottom:1rem}
  .sheetwrap iframe{width:100%; height:420px; border:0; display:block}
  .seasonblock{margin-bottom:2rem}
  .seasonblock h3{font-size:1.15rem; margin-bottom:.6rem}
  footer.sitefoot{border-top:1px solid var(--border); margin-top:2.5rem; padding:1.6rem 1.1rem 2.4rem; color:var(--ink-soft); font-size:.85rem}
  footer.sitefoot .fwrap{max-width:860px; margin:0 auto; display:flex; flex-wrap:wrap; gap:1.6rem; justify-content:space-between}
  footer.sitefoot .fcol strong{color:var(--ink)}
  footer.sitefoot a{color:var(--ink-soft)}
</style>
</head>
<body>

<header class="top noprint">
  <div class="topbar">
    <div class="brand-mark">M</div>
    <div><div class="brand-name">Máriás Portál</div><div class="brand-sub">Ung-vidék, Bodrogköz</div></div>
    <nav class="mainnav" id="mainnav"></nav>
  </div>
  <svg class="cardstrip noprint" viewBox="0 0 320 34" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="cardpat" width="80" height="34" patternUnits="userSpaceOnUse">
        <rect width="80" height="34" fill="var(--surface-2)"/>
        <circle cx="10" cy="17" r="6" fill="var(--gold)"/>
        <path d="M30 11 q6 0 6 6 q0 6 -6 10 q-6 -4 -6 -10 q0 -6 6 -6 z" fill="var(--accent)"/>
        <path d="M50 24 q-5 0 -5 -6 q0 -5 5 -7 q5 2 5 7 q0 6 -5 6 z" fill="var(--accent-strong)"/>
        <ellipse cx="70" cy="17" rx="5" ry="7" fill="var(--gold)" opacity=".75"/>
      </pattern>
    </defs>
    <rect width="320" height="34" fill="url(#cardpat)"/>
  </svg>
</header>

<div class="wrap" id="view"></div>
<footer class="sitefoot noprint" id="site-footer"></footer>

<script src="https://cdn.jsdelivr.net/npm/firebase@8.10.1/firebase-app.js"></script>
<script src="https://cdn.jsdelivr.net/npm/firebase@8.10.1/firebase-firestore.js"></script>
<script src="https://cdn.jsdelivr.net/npm/firebase@8.10.1/firebase-auth.js"></script>
<script src="https://cdn.jsdelivr.net/npm/firebase@8.10.1/firebase-storage.js"></script>
<script>
(function(){
  "use strict";

  var firebaseConfig = {
    apiKey: "AIzaSyCIZwZB-O-uFyp19zOpMnCk8nwp_hLIKDc",
    authDomain: "mub-versenyek.firebaseapp.com",
    projectId: "mub-versenyek",
    storageBucket: "mub-versenyek.firebasestorage.app",
    messagingSenderId: "93113038120",
    appId: "1:93113038120:web:c9b3f8189c7a46cd5e0c1d"
  };
  firebase.initializeApp(firebaseConfig);
  var db = firebase.firestore();
  var auth = firebase.auth();
  var storage = firebase.storage();

  /* ---------- helpers ---------- */
  function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
  function nl2br(s){ return esc(s).replace(/\n/g,'<br>'); }
  function uid(){ return Math.random().toString(36).slice(2,10)+Date.now().toString(36); }
  function loadPrefs(){ try{ return JSON.parse(localStorage.getItem('mub-prefs')||'{}'); }catch(e){ return {}; } }
  function savePrefs(p){ try{ localStorage.setItem('mub-prefs', JSON.stringify(p)); }catch(e){} }
  var PREFS = Object.assign({lang:'hu', ts:'ts-2'}, loadPrefs());
  var lang = PREFS.lang;
  function T(hu, sk){ return lang==='sk' ? (sk||hu||'') : (hu||sk||''); }
  function fmtDate(iso){
    if(!iso) return '';
    var p = iso.split('-'); var d = new Date(Date.UTC(+p[0], +p[1]-1, +p[2]));
    try{ return d.toLocaleDateString(lang==='sk'?'sk-SK':'hu-HU', {year:'numeric', month:'long', day:'numeric'}); }catch(e){ return iso; }
  }
  function byDateAsc(a,b){ return (a.date||'').localeCompare(b.date||''); }
  function byDateDesc(a,b){ return (b.date||'').localeCompare(a.date||''); }
  function todayISO(){ return new Date().toISOString().slice(0,10); }
  var TAG_LABELS = {
    nomub: {hu:'nem MUB liga', sk:'mimo ligy MUB'},
    szezonnyito: {hu:'Szezonnyitó', sk:'Otvorenie sezóny'},
    szezonzaro: {hu:'Szezonzáró', sk:'Záver sezóny'},
    donto: {hu:'Döntő', sk:'Finále'}
  };
  function tagLabel(tag){
    if(!tag) return '';
    var t = TAG_LABELS[tag];
    return t ? T(t.hu, t.sk) : tag;
  }
  function sheetEmbedUrl(url){
    if(!url) return '';
    var idm = url.match(/\/spreadsheets\/d\/([a-zA-Z0-9-_]+)/);
    if(!idm) return '';
    var gidm = url.match(/[?&#]gid=(\d+)/);
    var gid = gidm ? gidm[1] : '0';
    return 'https://docs.google.com/spreadsheets/d/'+idm[1]+'/edit?usp=sharing&rm=minimal&single=true&widget=true&headers=false&gid='+gid;
  }

  /* ---------- auth state ---------- */
  var currentUser = null;
  var isAdmin = false;

  /* ---------- in-memory caches ---------- */
  var CACHE = { tournaments:null, news:null, gallery:null, players:null, seasons:null, downloads:null };

  function loadTournaments(cb){
    if(CACHE.tournaments) return cb(CACHE.tournaments);
    db.collection('tournaments').get().then(function(snap){
      var arr = []; snap.forEach(function(d){ arr.push(Object.assign({id:d.id}, d.data())); });
      CACHE.tournaments = arr; cb(arr);
    }).catch(function(e){ console.error(e); cb([]); });
  }
  function loadNews(cb){
    if(CACHE.news) return cb(CACHE.news);
    db.collection('news').get().then(function(snap){
      var arr = []; snap.forEach(function(d){ arr.push(Object.assign({id:d.id}, d.data())); });
      CACHE.news = arr; cb(arr);
    }).catch(function(e){ console.error(e); cb([]); });
  }
  function loadGallery(cb){
    if(CACHE.gallery) return cb(CACHE.gallery);
    db.collection('gallery').get().then(function(snap){
      var arr = []; snap.forEach(function(d){ arr.push(Object.assign({id:d.id}, d.data())); });
      CACHE.gallery = arr; cb(arr);
    }).catch(function(e){ console.error(e); cb([]); });
  }
  function loadPlayers(cb){
    if(CACHE.players) return cb(CACHE.players);
    db.collection('players').get().then(function(snap){
      var arr = []; snap.forEach(function(d){ arr.push(Object.assign({code:d.id}, d.data())); });
      CACHE.players = arr; cb(arr);
    }).catch(function(e){ console.error(e); cb([]); });
  }
  function loadSeasons(cb){
    if(CACHE.seasons) return cb(CACHE.seasons);
    db.collection('seasons').get().then(function(snap){
      var arr = []; snap.forEach(function(d){ arr.push(Object.assign({id:d.id}, d.data())); });
      CACHE.seasons = arr; cb(arr);
    }).catch(function(e){ console.error(e); cb([]); });
  }
  function loadDownloads(cb){
    if(CACHE.downloads) return cb(CACHE.downloads);
    db.collection('downloads').get().then(function(snap){
      var arr = []; snap.forEach(function(d){ arr.push(Object.assign({id:d.id}, d.data())); });
      CACHE.downloads = arr; cb(arr);
    }).catch(function(e){ console.error(e); cb([]); });
  }
  function invalidate(key){ CACHE[key] = null; }

  /* ---------- router ---------- */
  var ROUTES = ['home','naptar','galeria','jelentkezes','eredmenyek','szabalyok','admin'];
  function currentRoute(){
    var h = (location.hash||'#home').replace('#','');
    var base = h.split('/')[0];
    return ROUTES.indexOf(base)>=0 ? base : 'home';
  }
  window.addEventListener('hashchange', render);

  function renderNav(){
    var route = currentRoute();
    var items = [
      ['home','Kezdőlap','Domov'],
      ['naptar','Versenynaptár','Kalendár'],
      ['eredmenyek','Eredmények','Výsledky'],
      ['galeria','Galéria','Galéria'],
      ['jelentkezes','Jelentkezés','Prihlásenie'],
      ['szabalyok','Szabályok','Pravidlá']
    ];
    var html = items.map(function(it){
      return '<a href="#'+it[0]+'" class="'+(route===it[0]?'active':'')+'">'+esc(T(it[1],it[2]))+'</a>';
    }).join('');
    html += '<a href="#admin" class="'+(route==='admin'?'active':'')+'">'+(isAdmin?'Admin':'Szervezőknek')+'</a>';
    html += '<div class="toolgroup">'
      + '<button class="toolbtn" title="'+esc(T('Kisebb betű','Menšie písmo'))+'" onclick="MUB.textSize(-1)">A−</button>'
      + '<button class="toolbtn" title="'+esc(T('Nagyobb betű','Väčšie písmo'))+'" onclick="MUB.textSize(1)">A+</button>'
      + '<button class="toolbtn" onclick="MUB.toggleLang()">'+(lang==='hu'?'SK':'HU')+'</button>'
      + '</div>';
    document.getElementById('mainnav').innerHTML = html;
  }

  function toggleLang(){ lang = lang==='hu' ? 'sk' : 'hu'; PREFS.lang = lang; savePrefs(PREFS); render(); }
  function textSize(d){
    var order = ['ts-1','ts-2','ts-3'];
    var i = order.indexOf(PREFS.ts||'ts-2');
    i = Math.max(0, Math.min(order.length-1, i+d));
    PREFS.ts = order[i]; savePrefs(PREFS);
    document.documentElement.className = PREFS.ts;
  }

  function render(){
    renderNav();
    renderFooter();
    var route = currentRoute();
    var el = document.getElementById('view');
    if(route==='home') return renderHome(el);
    if(route==='naptar') return renderCalendar(el);
    if(route==='galeria') return renderGallery(el);
    if(route==='jelentkezes') return renderRegister(el);
    if(route==='eredmenyek') return renderResults(el);
    if(route==='szabalyok') return renderRules(el);
    if(route==='admin') return renderAdmin(el);
  }

  /* ---------- HOME ---------- */
  function renderHome(el){
    el.innerHTML = '<h1 class="page-title">'+esc(T('Üdvözlünk!','Vitajte!'))+'</h1><div class="rule"></div><div id="home-body">'+esc(T('Betöltés…','Načítava sa…'))+'</div>';
    loadTournaments(function(ts){
      loadNews(function(news){
        loadSeasons(function(seasons){
          var upcoming = ts.filter(function(t){ return t.date >= todayISO(); }).sort(byDateAsc).slice(0,4);
          var newsSorted = news.slice().sort(byDateDesc).slice(0,5);
          var current = seasons.filter(function(s){ return s.current; })[0]
            || seasons.slice().sort(function(a,b){ return (b.label||'').localeCompare(a.label||''); })[0];
          var html = '';
          html += '<h2 style="margin-bottom:.6rem">'+esc(T('Közelgő versenyek','Nadchádzajúce turnaje'))+'</h2>';
          if(!upcoming.length){
            html += '<p class="meta">'+esc(T('Jelenleg nincs meghirdetett verseny.','Momentálne nie je vyhlásený žiadny turnaj.'))+'</p>';
          }
          html += upcoming.map(function(t){
            return '<div class="eventcard">'
              + '<div class="title">'+esc(T(t.location_hu,t.location_sk))+(t.tag?'<span class="badge">'+esc(tagLabel(t.tag))+'</span>':'')+'</div>'
              + '<div class="meta num">'+fmtDate(t.date)+' · '+esc(t.time_start||'8:30')+'–'+esc(t.time_end||'15:30')+'</div>'
              + (t.registrationOpen ? '<div style="margin-top:.5rem"><a class="btn sm" href="#jelentkezes">'+esc(T('Jelentkezés','Prihlásenie'))+'</a></div>' : '')
              + '</div>';
          }).join('');
          html += '<h2 style="margin:1.6rem 0 .6rem">'+esc(T('Hírfolyam','Novinky'))+'</h2>';
          if(!newsSorted.length){ html += '<p class="meta">'+esc(T('Még nincs hír.','Zatiaľ žiadne správy.'))+'</p>'; }
          html += newsSorted.map(function(n){
            return '<div class="card" style="margin-bottom:.7rem"><div class="meta num">'+fmtDate(n.date)+'</div><div>'+nl2br(T(n.text_hu,n.text_sk))+'</div>'
              + (n.imageUrl ? '<img src="'+esc(n.imageUrl)+'" style="max-width:100%;border-radius:8px;margin-top:.6rem" loading="lazy" alt="">' : '')
              + '</div>';
          }).join('');
          html += '<h2 style="margin:1.6rem 0 .6rem">'+esc(T('Legfrissebb eredmények','Najnovšie výsledky'))+'</h2>';
          if(!current){
            html += '<p class="meta">'+esc(T('Még nincs feltöltött szezon eredmény.','Zatiaľ nie sú nahraté výsledky sezóny.'))+'</p>';
          } else {
            html += '<div class="meta" style="margin-bottom:.5rem">'+esc(T('Szezon','Sezóna'))+' '+esc(current.label||'')+'</div>';
            if(current.aggregateUrl){
              html += '<div class="sheetwrap"><iframe src="'+esc(sheetEmbedUrl(current.aggregateUrl))+'" loading="lazy"></iframe></div>';
            } else if(current.perTournamentUrl){
              html += '<div class="sheetwrap"><iframe src="'+esc(sheetEmbedUrl(current.perTournamentUrl))+'" loading="lazy"></iframe></div>';
            }
            html += '<div style="margin-bottom:1rem"><a class="btn sm secondary" href="#eredmenyek">'+esc(T('Összes eredmény →','Všetky výsledky →'))+'</a></div>';
          }
          document.getElementById('home-body').innerHTML = html;
        });
      });
    });
  }

  /* ---------- RESULTS ---------- */
  function renderResults(el){
    el.innerHTML = '<h1 class="page-title">'+esc(T('Eredmények','Výsledky'))+'</h1><div class="rule"></div><div id="res-body">'+esc(T('Betöltés…','Načítava sa…'))+'</div>';
    loadSeasons(function(seasons){
      var sorted = seasons.slice().sort(function(a,b){ return (b.label||'').localeCompare(a.label||''); });
      if(!sorted.length){
        document.getElementById('res-body').innerHTML = '<p class="meta">'+esc(T('Még nincs feltöltött eredmény.','Zatiaľ nie sú nahraté výsledky.'))+'</p>';
        return;
      }
      var html = sorted.map(function(s){
        return '<div class="seasonblock"><h3>'+esc(T('Szezon','Sezóna'))+' '+esc(s.label||'')+(s.current?'<span class="badge">'+esc(T('aktuális','aktuálna'))+'</span>':'')+'</h3>'
          + (s.aggregateUrl ? '<div class="meta" style="margin-bottom:.3rem">'+esc(T('Összesített eredmény','Súhrnné výsledky'))+'</div><div class="sheetwrap"><iframe src="'+esc(sheetEmbedUrl(s.aggregateUrl))+'" loading="lazy"></iframe></div>' : '')
          + (s.perTournamentUrl ? '<div class="meta" style="margin:.6rem 0 .3rem">'+esc(T('Versenyenkénti eredmények','Výsledky podľa turnajov'))+'</div><div class="sheetwrap"><iframe src="'+esc(sheetEmbedUrl(s.perTournamentUrl))+'" loading="lazy"></iframe></div>' : '')
          + (!s.aggregateUrl && !s.perTournamentUrl ? '<p class="meta">'+esc(T('Ehhez a szezonhoz még nincs feltöltve eredmény.','Pre túto sezónu ešte nie sú nahraté výsledky.'))+'</p>' : '')
          + '</div>';
      }).join('');
      document.getElementById('res-body').innerHTML = html;
    });
  }

  /* ---------- CALENDAR ---------- */
  function renderCalendar(el){
    el.innerHTML = '<h1 class="page-title">'+esc(T('Versenynaptár','Kalendár turnajov'))+'</h1><div class="rule"></div><div id="cal-body">'+esc(T('Betöltés…','Načítava sa…'))+'</div>';
    loadTournaments(function(ts){
      var sorted = ts.slice().sort(byDateAsc);
      var html = sorted.map(function(t){
        var past = t.date < todayISO();
        return '<div class="eventcard'+(past?' closed':'')+'">'
          + '<div class="title">'+esc(T(t.location_hu,t.location_sk))+(t.tag?'<span class="badge">'+esc(tagLabel(t.tag))+'</span>':'')+'</div>'
          + '<div class="meta num">'+fmtDate(t.date)+' · '+esc(t.time_start||'8:30')+'–'+esc(t.time_end||'15:30')+'</div>'
          + (t.resultsSheetUrl ? '<div style="margin-top:.4rem"><a href="'+esc(t.resultsSheetUrl)+'" target="_blank" rel="noopener">'+esc(T('Eredmények (Google Sheet)','Výsledky (Google Sheet)'))+'</a></div>' : '')
          + (t.registrationOpen ? '<div style="margin-top:.5rem"><a class="btn sm" href="#jelentkezes">'+esc(T('Jelentkezés','Prihlásenie'))+'</a></div>' : '')
          + '</div>';
      }).join('');
      document.getElementById('cal-body').innerHTML = html || '<p class="meta">'+esc(T('Még nincs felvett verseny.','Zatiaľ žiadny turnaj.'))+'</p>';
    });
  }

  /* ---------- GALLERY ---------- */
  function renderGallery(el){
    el.innerHTML = '<h1 class="page-title">'+esc(T('Galéria','Galéria'))+'</h1><div class="rule"></div><div id="gal-body">'+esc(T('Betöltés…','Načítava sa…'))+'</div>';
    loadTournaments(function(ts){
      loadGallery(function(photos){
        var byKey = {};
        photos.forEach(function(p){
          var key = p.tournamentId ? ('t:'+p.tournamentId) : ('c:'+(p.customTitle||''));
          (byKey[key] = byKey[key]||[]).push(p);
        });
        var groups = Object.keys(byKey).map(function(key){
          var pics = byKey[key].slice().sort(function(a,b){ return (b.isPodium?1:0)-(a.isPodium?1:0); });
          if(key.indexOf('t:')===0){
            var tid = key.slice(2);
            var t = ts.filter(function(x){return x.id===tid;})[0];
            if(!t) return null;
            return {label: T(t.location_hu,t.location_sk), date: t.date, pics: pics};
          } else {
            var title = key.slice(2);
            if(!title) return null;
            return {label: title, date: '', pics: pics};
          }
        }).filter(Boolean).sort(function(a,b){ return (b.date||'').localeCompare(a.date||''); });
        if(!groups.length){ document.getElementById('gal-body').innerHTML = '<p class="meta">'+esc(T('Még nincs fotó a galériában.','Zatiaľ žiadne fotky.'))+'</p>'; return; }
        var html = groups.map(function(g){
          return '<div class="gallerygroup"><div class="ghead">'+esc(g.label)+(g.date?' <span class="meta num">'+fmtDate(g.date)+'</span>':'')+'</div>'
            + '<div class="thumbgrid">'+g.pics.map(function(p){
              return '<a class="ph" href="'+esc(p.url)+'" target="_blank" rel="noopener"><img src="'+esc(p.url)+'" loading="lazy" alt="">'+(p.isPodium?'<span class="podiummark">🏆</span>':'')+'</a>';
            }).join('')+'</div></div>';
        }).join('');
        document.getElementById('gal-body').innerHTML = html;
      });
    });
  }

  /* ---------- REGISTER (public) ---------- */
  var selectedTid = null;
  function renderRegister(el){
    el.innerHTML = '<h1 class="page-title">'+esc(T('Jelentkezés','Prihlásenie'))+'</h1><div class="rule"></div><div id="reg-body">'+esc(T('Betöltés…','Načítava sa…'))+'</div>';
    loadTournaments(function(ts){
      var open = ts.filter(function(t){ return t.registrationOpen; }).sort(byDateAsc);
      if(!open.length){
        document.getElementById('reg-body').innerHTML = '<p class="meta">'+esc(T('Jelenleg nincs nyitott jelentkezés versenyre.','Momentálne nie je otvorené prihlasovanie na turnaj.'))+'</p>';
        return;
      }
      if(!selectedTid || !open.some(function(t){return t.id===selectedTid;})) selectedTid = open[0].id;
      var list = open.map(function(t){
        return '<div class="eventcard" style="cursor:pointer;'+(t.id===selectedTid?'background:var(--accent-soft);border-left-color:var(--accent-strong)':'')+'" onclick="MUB.selectTournament(\''+t.id+'\')">'
          + '<div class="title">'+esc(T(t.location_hu,t.location_sk))+'</div>'
          + '<div class="meta num">'+fmtDate(t.date)+'</div></div>';
      }).join('');
      var formHtml = ''
        + '<form id="reg-form" class="card stack">'
        + '<div class="field"><label>'+esc(T('Kód (ha van)','Kód (ak máš)'))+'</label><input id="f-code" placeholder="pl. 14" oninput="MUB.lookupCode(this.value)"></div>'
        + '<div class="field"><label>'+esc(T('Név','Meno'))+'</label><input id="f-name" required placeholder="'+esc(T('Vezetéknév és keresztnév','Priezvisko a meno'))+'"></div>'
        + '<p id="f-name-hint" class="meta" hidden>'+esc(T('Kód alapján automatikusan kitöltve.','Automaticky vyplnené podľa kódu.'))+'</p>'
        + '<button class="btn" type="submit" id="submit-btn">'+esc(T('Jelentkezés elküldése','Odoslať prihlášku'))+'</button>'
        + '</form>';
      document.getElementById('reg-body').innerHTML = list + formHtml
        + '<div id="reg-confirm" class="card confirm" hidden><div class="mark">✓</div><h2>'+esc(T('Jelentkezés elküldve!','Prihláška odoslaná!'))+'</h2>'
        + '<button class="btn secondary sm" onclick="MUB.cancelRegistration()" id="cancel-reg-btn">'+esc(T('Mégsem, visszavonom','Predsa len, zrušiť'))+'</button> '
        + '<button class="btn secondary sm" onclick="MUB.resetRegForm()">'+esc(T('Új jelentkezés','Nová prihláška'))+'</button></div>';
      document.getElementById('reg-form').addEventListener('submit', submitRegistration);
    });
  }
  function selectTournament(id){ selectedTid = id; renderRegister(document.getElementById('view')); }
  function lookupCode(code){
    code = (code||'').trim();
    var nameEl = document.getElementById('f-name');
    var hint = document.getElementById('f-name-hint');
    if(!nameEl) return;
    if(!code){
      if(nameEl.readOnly){ nameEl.readOnly = false; nameEl.value = ''; hint.hidden = true; }
      return;
    }
    loadPlayers(function(players){
      var p = players.filter(function(x){ return x.code===code; })[0];
      if(p){
        nameEl.value = p.name; nameEl.readOnly = true; hint.hidden = false;
      } else if(nameEl.readOnly){
        nameEl.readOnly = false; nameEl.value = ''; hint.hidden = true;
      }
    });
  }
  var lastRegId = null;
  function submitRegistration(ev){
    ev.preventDefault();
    var name = document.getElementById('f-name').value.trim();
    if(!name || !selectedTid) return;
    var btn = document.getElementById('submit-btn');
    btn.disabled = true; btn.textContent = T('Küldés…','Odosiela sa…');
    db.collection('registrations').add({
      tournamentId: selectedTid,
      name: name,
      code: document.getElementById('f-code').value.trim(),
      ts: firebase.firestore.FieldValue.serverTimestamp()
    }).then(function(docRef){
      lastRegId = docRef.id;
      document.getElementById('reg-form').hidden = true;
      document.getElementById('reg-confirm').hidden = false;
    }).catch(function(err){
      alert(T('A jelentkezés nem sikerült, próbáld meg újra.','Prihlásenie zlyhalo, skús to znova.') + ' (' + err.message + ')');
    }).finally(function(){
      btn.disabled = false; btn.textContent = T('Jelentkezés elküldése','Odoslať prihlášku');
    });
  }
  function cancelRegistration(){
    if(!lastRegId) return;
    var btn = document.getElementById('cancel-reg-btn');
    btn.disabled = true;
    db.collection('registrations').doc(lastRegId).delete().then(function(){
      lastRegId = null;
      alert(T('A jelentkezésed visszavontuk.','Tvoju prihlášku sme zrušili.'));
      resetRegForm();
    }).catch(function(err){
      btn.disabled = false;
      alert(T('Nem sikerült visszavonni: ','Nepodarilo sa zrušiť: ') + err.message);
    });
  }
  function resetRegForm(){ renderRegister(document.getElementById('view')); }

  /* ---------- RULES / FOOTER (static bilingual content) ---------- */
  var RULES_SK = `1. Miešanie
Karty sa miešajú prekladaním 2 až 3-krát, nie prekladaním naslepo (zakladaním).

2. Tromf
Tromf musí byť vyložený bokom, oddelene od ostatných kariet.
Pri voľbe národa si najprv vytiahnite tromf bokom a zvyšné 4 karty vezmite naraz.

3. Zber štichov
Druhý štich sa berie naraz.

4. Hlášky
Sto-sedem (100-7) z ruky sa hlási iba s červenou farbou.
Pri nahlásení stovky alebo sto-sedem (100-7) platí len jedna hláška.

5. Zdobrovanie
Po zdobrovaní farby položte karty na stôl, neprekladajte ich ešte.

6. Časový limit
Na vyjadrenie sa k farbe alebo na zahranie karty máte 15 sekúnd.

7. Flekovanie
Flekovať sa môže pri hre a sedme 4-krát, pri malom a veľkom 2-krát.

8. Porušenie pravidiel
Pri nepriznaní farby alebo porušení pravidla "iberu" je možné pokračovať v hre, ak si to protihráč želá.
Pri druhom nesprávnom rozdaní kariet v jednom kole je pokuta 10 centov.
Za nepriznanie farby alebo "beru" je pokuta 25 centov.

9. Špekulácie s tromfom
Ak tromf nie je jasne vyložený, alebo ak pri voľbe národa hráč nevyloží tromf ako prvú kartu, platí pokuta 1 euro a žltá karta na celú sezónu.
Pri opakovanom priestupku bude hráč zo sezóny vylúčený.

10. Nehrateľná hra
Pri nahlásení nehrateľnej hry (napríklad sedma, ktorú nemáte, alebo stovka bez hlášok) zaplatí hráč nahlásenú hru.
V takomto prípade sa neflekuje.

11. Predčasné ukončenie kola
Ak hráč nemá peniaze a predčasne ukončí kolo, skóre sa zapisujú do mínusu.

12. Chyby v talóne
Pri zistení desiatky alebo esa v talóne je pokuta 50 centov.
Rovnaká pokuta platí aj v prípade, ak sú v talóne tri karty.

13. Malý a veľký flek
Vyložený malý a veľký môžu byť flekované, a ešte lepšie, ak sú bez reno.

14. Nesprávne vychádzanie
Ak hráč, ktorý nemá vychádzať, napriek tomu ukáže kartu prvú chybu odpustime, ale 2. chyba už zaplatí renos 25 centov.

15. Peniaze
Peniaze môžu byť počas hry v stĺpcoch, ale pred poslednou hrou musí majiteľ dovoliť súperovi skontrolovať stav peňazí.`;

  var RULES_HU = `1. Keverés
A kártyát 2-3 alkalommal kell keverni (hidalással), vakon keverni (alaphelyzetből visszarakva) nem szabad.

2. Tromf
A tromfot külön, a többi laptól elkülönítve kell letenni.
Színválasztásnál először a tromfot húzd ki külön, a maradék 4 lapot pedig egyszerre vedd fel.

3. Ütés felvétele
A második ütést egyszerre kell felvenni.

4. Bemondások
A száz-hetet (100-7) kézből csak piros színnel lehet bemondani.
Száz vagy száz-hét (100-7) bemondásakor csak egy bemondás érvényes.

5. Színjavítás
Színjavítás után tedd le a lapokat az asztalra, még ne keverd össze őket.

6. Időkorlát
A színre való reagálásra vagy a lap kijátszására 15 másodperc áll rendelkezésre.

7. Flekkelés
Flekkelni játéknál és hetesnél 4-szer, kicsinél és nagynál 2-szer lehet.

8. Szabálysértés
Ha valaki nem vall színt, vagy megszegi az "adok-veszek" szabályát, a játék folytatható, ha az ellenfél úgy kívánja.
Egy körön belüli második hibás osztásért 10 cent büntetés jár.
Színnem-vallásért vagy a "beru" szabály megszegéséért 25 cent büntetés jár.

9. Spekuláció a tromffal
Ha a tromf nincs egyértelműen letéve, vagy ha színválasztásnál a játékos nem a tromfot teszi le elsőként, 1 euró büntetés és sárga lap jár a teljes szezonra.
Ismételt szabálysértés esetén a játékost kizárják a szezonból.

10. Nem játszható lap
Ha valaki olyan játékot jelent be, ami nem játszható (pl. olyan hetest, amije nincs, vagy bemondás nélküli százat), a bejelentett játékot ő fizeti.
Ilyenkor nem lehet flekkelni.

11. Kör idő előtti befejezése
Ha egy játékosnak nincs pénze, és emiatt idő előtt befejezi a kört, az eredményét mínuszba írják.

12. Talonhibák
Ha tízest vagy ászt találnak a talonban, 50 cent büntetés jár.
Ugyanez a büntetés jár akkor is, ha a talonban három lap van.

13. Kis és nagy flek
A kitett kicsi és nagy flekkelhető, és még jobb, ha renó nélküli.

14. Helytelen kijátszás
Ha egy játékos, akinek nem kellene kijátszania, mégis kitesz egy lapot, az első hibát elnézzük, de a 2. hibáért már 25 cent renót kell fizetni.

15. Pénzkezelés
A pénz a játék alatt lehet oszlopokban, de az utolsó játék előtt a tulajdonosnak meg kell engednie az ellenfélnek, hogy ellenőrizze a pénz állását.`;

  function renderRules(el){
    el.innerHTML = '<h1 class="page-title">'+esc(T('Szabályok','Pravidlá'))+'</h1><div class="rule"></div><div class="card">'+nl2br(T(RULES_HU,RULES_SK))+'</div><div id="rules-downloads" style="margin-top:1.4rem"></div>';
    loadDownloads(function(items){
      var box = document.getElementById('rules-downloads');
      if(!box) return;
      if(!items.length){ box.innerHTML=''; return; }
      box.innerHTML = '<h2 style="margin-bottom:.6rem">'+esc(T('Letölthető segédanyagok','Súbory na stiahnutie'))+'</h2>'
        + items.map(function(d){ return '<div class="card" style="margin-bottom:.5rem"><a href="'+esc(d.url)+'" target="_blank" rel="noopener">'+esc(d.label)+'</a></div>'; }).join('');
    });
  }
  var CONTACTS = [
    {name:'Jónás Csaba', role_hu:'Versenyszervező', role_sk:'Organizátor turnajov', phone:'0949 822 370', email:''},
    {name:'ifj. Juhász János', role_hu:'Excel-program, pontszámítás', role_sk:'Excel program, výpočet bodov', phone:'0907 548 084', email:'jan.juhasz6@gmail.com'}
  ];
  function renderFooter(){
    var f = document.getElementById('site-footer');
    if(!f) return;
    f.innerHTML = '<div class="fwrap">'
      + '<div class="fcol"><strong>Máriás Portál</strong><div>Ung-vidék, Bodrogköz · mub.sk</div></div>'
      + CONTACTS.map(function(c){
        return '<div class="fcol"><strong>'+esc(c.name)+'</strong><div>'+esc(T(c.role_hu,c.role_sk))+'</div>'
          + (c.phone?'<div class="num">'+esc(c.phone)+'</div>':'')
          + (c.email?'<div><a href="mailto:'+esc(c.email)+'">'+esc(c.email)+'</a></div>':'')
          + '</div>';
      }).join('')
      + '</div>';
  }

  /* ================= ADMIN ================= */
  var adminTab = 'versenyek';
  function renderAdmin(el){
    if(!currentUser){
      el.innerHTML = ''
        + '<h1 class="page-title">'+esc(T('Szervezői felület','Organizátorská časť'))+'</h1><div class="rule"></div>'
        + '<div class="card" style="max-width:26rem">'
        + '<div class="field"><label>E-mail</label><input id="login-email" type="email"></div>'
        + '<div class="field"><label>'+esc(T('Jelszó','Heslo'))+'</label><input id="login-pass" type="password"></div>'
        + '<button class="btn" onclick="MUB.login()">'+esc(T('Bejelentkezés','Prihlásiť sa'))+'</button>'
        + '<p id="login-error" class="meta" style="color:var(--danger)" hidden></p>'
        + '<p style="margin-top:.9rem"><a href="#" onclick="MUB.forgotPassword();return false;">'+esc(T('Elfelejtett jelszó?','Zabudnuté heslo?'))+'</a></p>'
        + '<p id="login-info" class="meta" style="color:var(--accent-strong)" hidden></p>'
        + '</div>';
      return;
    }
    var tabs = [['versenyek','Versenyek'],['szezonok','Szezonok'],['hirek','Hírek'],['galeria','Galéria'],['jelentkezok','Jelentkezők'],['jatekosok','Játékosok'],['letoltesek','Letöltések']];
    var html = '<div class="toolbar"><div><h1 class="page-title" style="display:inline">'+esc(T('Admin','Admin'))+'</h1> <span class="meta">'+esc(currentUser.email)+'</span></div>'
      + '<button class="btn sm secondary noprint" onclick="MUB.logout()">'+esc(T('Kijelentkezés','Odhlásiť sa'))+'</button></div>'
      + '<div class="tabs noprint">'+tabs.map(function(t){ return '<button class="'+(adminTab===t[0]?'active':'')+'" onclick="MUB.setAdminTab(\''+t[0]+'\')">'+t[1]+'</button>'; }).join('')+'</div>'
      + '<div id="admin-body"></div>';
    el.innerHTML = html;
    if(adminTab==='versenyek') renderAdminTournaments();
    else if(adminTab==='szezonok') renderAdminSeasons();
    else if(adminTab==='hirek') renderAdminNews();
    else if(adminTab==='galeria') renderAdminGallery();
    else if(adminTab==='jelentkezok') renderAdminRegistrations();
    else if(adminTab==='jatekosok') renderAdminPlayers();
    else if(adminTab==='letoltesek') renderAdminDownloads();
  }
  function setAdminTab(t){ adminTab = t; renderAdmin(document.getElementById('view')); }

  function login(){
    var email = document.getElementById('login-email').value.trim();
    var pass = document.getElementById('login-pass').value;
    auth.signInWithEmailAndPassword(email, pass).catch(function(err){
      var e = document.getElementById('login-error'); e.hidden=false;
      e.textContent = T('Hibás e-mail vagy jelszó.','Nesprávny e-mail alebo heslo.') + '  [' + (err.code||err.message) + ']';
    });
  }
  function logout(){ auth.signOut(); }
  function forgotPassword(){
    var email = document.getElementById('login-email').value.trim();
    if(!email){
      var e = document.getElementById('login-error'); e.hidden=false; e.textContent = T('Írd be az e-mail címed a mezőbe, utána kattints ide.','Najprv zadaj e-mail vyššie, potom klikni sem.');
      return;
    }
    auth.sendPasswordResetEmail(email).then(function(){
      var i = document.getElementById('login-info'); i.hidden=false;
      i.textContent = T('Elküldtük a jelszó-visszaállító linket erre a címre: ','Odoslali sme odkaz na obnovenie hesla na: ') + email;
      document.getElementById('login-error').hidden = true;
    }).catch(function(err){
      var e = document.getElementById('login-error'); e.hidden=false;
      e.textContent = T('Nem sikerült elküldeni: ','Nepodarilo sa odoslať: ') + err.message;
    });
  }

  /* --- admin: tournaments --- */
  function renderAdminTournaments(){
    var body = document.getElementById('admin-body');
    body.innerHTML = '<div class="card" style="margin-bottom:1.2rem"><h3 style="margin-bottom:.8rem">'+T('Új verseny','Nový turnaj')+'</h3><div id="t-form"></div></div><div id="t-list"></div>';
    renderTournamentForm(null);
    invalidate('tournaments');
    loadTournaments(function(ts){
      var sorted = ts.slice().sort(byDateDesc);
      document.getElementById('t-list').innerHTML = '<div class="table-wrap"><table class="list"><thead><tr><th>Helyszín</th><th>Dátum</th><th>Idő</th><th>Jelzés</th><th>Jelentkezés</th><th></th></tr></thead><tbody>'
        + sorted.map(function(t){
          return '<tr><td>'+esc(t.location_hu)+'</td><td class="num">'+esc(t.date)+'</td><td class="num">'+esc(t.time_start||'8:30')+'–'+esc(t.time_end||'15:30')+'</td><td>'+esc(tagLabel(t.tag)||'—')+'</td>'
            + '<td>'+(t.registrationOpen?'<span style="color:var(--accent-strong);font-weight:700">nyitva</span>':'zárva')+'</td>'
            + '<td><button class="btn sm secondary" onclick="MUB.editTournament(\''+t.id+'\')">Szerkeszt</button> <button class="btn sm danger" onclick="MUB.deleteTournament(\''+t.id+'\')">Törlés</button></td></tr>';
        }).join('') + '</tbody></table></div>';
    });
  }
  function renderTournamentForm(t){
    t = t || {location_hu:'',location_sk:'',date:'',time_start:'8:30',time_end:'15:30',tag:'',registrationOpen:false,resultsSheetUrl:''};
    var html = '<input type="hidden" id="t-id" value="'+esc(t.id||'')+'">'
      + '<div class="row2"><div class="field"><label>Helyszín (magyar)</label><input id="t-loc-hu" value="'+esc(t.location_hu)+'"></div>'
      + '<div class="field"><label>Miesto (szlovák)</label><input id="t-loc-sk" value="'+esc(t.location_sk)+'"></div></div>'
      + '<div class="row2"><div class="field"><label>Dátum</label><input id="t-date" type="date" value="'+esc(t.date)+'"></div>'
      + '<div class="field"><label>Jelzés (pl. nomub, szezonnyito, szezonzaro, donto)</label><input id="t-tag" list="tag-suggest" value="'+esc(t.tag)+'"><datalist id="tag-suggest"><option value="nomub"><option value="szezonnyito"><option value="szezonzaro"><option value="donto"></datalist></div></div>'
      + '<div class="row2"><div class="field"><label>Kezdés</label><input id="t-start" value="'+esc(t.time_start)+'"></div>'
      + '<div class="field"><label>Zárás</label><input id="t-end" value="'+esc(t.time_end)+'"></div></div>'
      + '<div class="field"><label>Eredmények link (Google Sheet, opcionális)</label><input id="t-sheet" value="'+esc(t.resultsSheetUrl||'')+'"></div>'
      + '<div class="field" style="flex-direction:row;align-items:center;gap:.5rem"><input type="checkbox" id="t-open" '+(t.registrationOpen?'checked':'')+' style="width:auto"><label style="margin:0">Nyitva a jelentkezésre</label></div>'
      + '<button class="btn sm" onclick="MUB.saveTournament()">Mentés</button> '+(t.id?'<button class="btn sm secondary" onclick="MUB.editTournament(null)">Mégse</button>':'');
    document.getElementById('t-form').innerHTML = html;
  }
  function editTournament(id){
    if(!id){ renderTournamentForm(null); return; }
    loadTournaments(function(ts){ renderTournamentForm(ts.filter(function(t){return t.id===id;})[0]); });
  }
  function saveTournament(){
    var id = document.getElementById('t-id').value;
    var loc_hu = document.getElementById('t-loc-hu').value.trim();
    if(!loc_hu) return;
    var data = {
      location_hu: loc_hu,
      location_sk: document.getElementById('t-loc-sk').value.trim(),
      date: document.getElementById('t-date').value,
      tag: document.getElementById('t-tag').value.trim(),
      time_start: document.getElementById('t-start').value.trim() || '8:30',
      time_end: document.getElementById('t-end').value.trim() || '15:30',
      resultsSheetUrl: document.getElementById('t-sheet').value.trim(),
      registrationOpen: document.getElementById('t-open').checked
    };
    var ref = id ? db.collection('tournaments').doc(id) : db.collection('tournaments').doc();
    ref.set(data, {merge:true}).then(function(){ invalidate('tournaments'); renderAdminTournaments(); });
  }
  function deleteTournament(id){
    if(!confirm('Biztosan törlöd?')) return;
    db.collection('tournaments').doc(id).delete().then(function(){ invalidate('tournaments'); renderAdminTournaments(); });
  }

  /* --- admin: seasons --- */
  function renderAdminSeasons(){
    var body = document.getElementById('admin-body');
    body.innerHTML = '<div class="card" style="margin-bottom:1.2rem"><h3 style="margin-bottom:.8rem">'+T('Új szezon','Nová sezóna')+'</h3><div id="s-form"></div></div><div id="s-list"></div>';
    renderSeasonForm(null);
    invalidate('seasons');
    loadSeasons(function(seasons){
      var sorted = seasons.slice().sort(function(a,b){ return (b.label||'').localeCompare(a.label||''); });
      document.getElementById('s-list').innerHTML = '<div class="table-wrap"><table class="list"><thead><tr><th>Szezon</th><th>Aktuális</th><th></th></tr></thead><tbody>'
        + sorted.map(function(s){
          return '<tr><td>'+esc(s.label)+'</td><td>'+(s.current?'<strong style="color:var(--accent-strong)">igen</strong>':'—')+'</td>'
            + '<td><button class="btn sm secondary" onclick="MUB.editSeason(\''+s.id+'\')">Szerkeszt</button> <button class="btn sm danger" onclick="MUB.deleteSeason(\''+s.id+'\')">Törlés</button></td></tr>';
        }).join('') + '</tbody></table></div>';
    });
  }
  function renderSeasonForm(s){
    s = s || {label:'',perTournamentUrl:'',aggregateUrl:'',current:false};
    var html = '<input type="hidden" id="s-id" value="'+esc(s.id||'')+'">'
      + '<div class="field"><label>Szezon megnevezése (pl. 2026-2027)</label><input id="s-label" value="'+esc(s.label)+'"></div>'
      + '<div class="field"><label>Versenyenkénti eredmények (Google Sheet link)</label><input id="s-per" value="'+esc(s.perTournamentUrl||'')+'"></div>'
      + '<div class="field"><label>Összesített eredmény (Google Sheet link)</label><input id="s-agg" value="'+esc(s.aggregateUrl||'')+'"></div>'
      + '<div class="field" style="flex-direction:row;align-items:center;gap:.5rem"><input type="checkbox" id="s-current" '+(s.current?'checked':'')+' style="width:auto"><label style="margin:0">Ez az aktuális szezon</label></div>'
      + '<button class="btn sm" onclick="MUB.saveSeason()">Mentés</button> '+(s.id?'<button class="btn sm secondary" onclick="MUB.editSeason(null)">Mégse</button>':'');
    document.getElementById('s-form').innerHTML = html;
  }
  function editSeason(id){
    if(!id){ renderSeasonForm(null); return; }
    loadSeasons(function(seasons){ renderSeasonForm(seasons.filter(function(s){return s.id===id;})[0]); });
  }
  function saveSeason(){
    var id = document.getElementById('s-id').value;
    var label = document.getElementById('s-label').value.trim();
    if(!label) return;
    var data = {
      label: label,
      perTournamentUrl: document.getElementById('s-per').value.trim(),
      aggregateUrl: document.getElementById('s-agg').value.trim(),
      current: document.getElementById('s-current').checked
    };
    var ref = id ? db.collection('seasons').doc(id) : db.collection('seasons').doc();
    if(!data.current){
      ref.set(data, {merge:true}).then(function(){ invalidate('seasons'); renderAdminSeasons(); });
      return;
    }
    loadSeasons(function(seasons){
      var batch = db.batch();
      seasons.forEach(function(s){ if(s.id!==ref.id) batch.set(db.collection('seasons').doc(s.id), {current:false}, {merge:true}); });
      batch.set(ref, data, {merge:true});
      batch.commit().then(function(){ invalidate('seasons'); renderAdminSeasons(); });
    });
  }
  function deleteSeason(id){
    if(!confirm('Biztosan törlöd?')) return;
    db.collection('seasons').doc(id).delete().then(function(){ invalidate('seasons'); renderAdminSeasons(); });
  }

  /* --- admin: news --- */
  function renderAdminNews(){
    var body = document.getElementById('admin-body');
    body.innerHTML = '<div class="card" style="margin-bottom:1.2rem"><h3 style="margin-bottom:.8rem">Új hír</h3>'
      + '<div class="field"><label>Szöveg (magyar)</label><textarea id="n-hu" rows="2"></textarea></div>'
      + '<div class="field"><label>Text (szlovák)</label><textarea id="n-sk" rows="2"></textarea></div>'
      + '<div class="field"><label>Dátum</label><input id="n-date" type="date" value="'+todayISO()+'"></div>'
      + '<div class="field"><label>Kép csatolása (opcionális)</label><input type="file" id="n-file" accept="image/*"></div>'
      + '<button class="btn sm" onclick="MUB.addNews()" id="n-add-btn">Közzététel</button></div><div id="n-list"></div>';
    invalidate('news');
    loadNews(function(news){
      var sorted = news.slice().sort(byDateDesc);
      document.getElementById('n-list').innerHTML = sorted.map(function(n){
        return '<div class="card" style="margin-bottom:.6rem"><div class="meta num">'+esc(n.date)+'</div><div>'+nl2br(n.text_hu)+'</div>'
          + (n.imageUrl ? '<img src="'+esc(n.imageUrl)+'" style="max-width:220px;border-radius:8px;margin-top:.5rem;display:block" loading="lazy" alt="">' : '')
          + '<button class="btn sm danger" style="margin-top:.5rem" onclick="MUB.deleteNews(\''+n.id+'\',\''+esc(n.imageStoragePath||'')+'\')">Törlés</button></div>';
      }).join('') || '<p class="meta">Még nincs hír.</p>';
    });
  }
  function addNews(){
    var hu = document.getElementById('n-hu').value.trim();
    if(!hu) return;
    var file = document.getElementById('n-file').files[0];
    var btn = document.getElementById('n-add-btn');
    btn.disabled = true; btn.textContent = 'Mentés…';
    var ref = db.collection('news').doc();
    var data = {
      text_hu: hu, text_sk: document.getElementById('n-sk').value.trim(),
      date: document.getElementById('n-date').value || todayISO(),
      createdAt: firebase.firestore.FieldValue.serverTimestamp()
    };
    function finish(){
      ref.set(data).then(function(){ invalidate('news'); renderAdminNews(); }).catch(function(err){
        btn.disabled=false; btn.textContent='Közzététel';
        alert('Nem sikerült menteni: ' + err.message);
      });
    }
    if(file){
      var path = 'news/'+ref.id+'/'+Date.now()+'-'+file.name;
      var sref = storage.ref().child(path);
      sref.put(file).then(function(){ return sref.getDownloadURL(); }).then(function(url){
        data.imageUrl = url; data.imageStoragePath = path;
        finish();
      }).catch(function(err){
        btn.disabled=false; btn.textContent='Közzététel';
        alert('A kép feltöltése nem sikerült: ' + err.message);
      });
    } else {
      finish();
    }
  }
  function deleteNews(id, storagePath){
    if(!confirm('Biztosan törlöd?')) return;
    db.collection('news').doc(id).delete().then(function(){
      if(storagePath){ storage.ref().child(storagePath).delete().catch(function(){}); }
      invalidate('news'); renderAdminNews();
    });
  }

  /* --- admin: gallery --- */
  var galleryMode = 'tournament'; /* 'tournament' | 'custom' */
  var galleryPickTid = '';
  var galleryCustomTitle = '';
  function renderAdminGallery(){
    var body = document.getElementById('admin-body');
    loadTournaments(function(ts){
      loadGallery(function(photos){
        var sorted = ts.slice().sort(byDateDesc);
        if(!galleryPickTid && sorted.length) galleryPickTid = sorted[0].id;
        var customTitles = [];
        photos.forEach(function(p){ if(!p.tournamentId && p.customTitle && customTitles.indexOf(p.customTitle)<0) customTitles.push(p.customTitle); });
        body.innerHTML = '<div class="card" style="margin-bottom:1.2rem">'
          + '<div class="radiorow"><label><input type="radio" name="g-mode" value="tournament" '+(galleryMode==='tournament'?'checked':'')+' onchange="MUB.setGalleryMode(this.value)"> Verseny</label>'
          + '<label><input type="radio" name="g-mode" value="custom" '+(galleryMode==='custom'?'checked':'')+' onchange="MUB.setGalleryMode(this.value)"> Egyéni album</label></div>'
          + '<div id="g-mode-picker"></div>'
          + '<div class="field"><label>Fotók feltöltése (a mobilod kamerájával is)</label><input type="file" id="g-file" accept="image/*" multiple capture="environment"></div>'
          + '<button class="btn sm" onclick="MUB.uploadPhotos()" id="g-upload-btn">Feltöltés</button>'
          + '<p class="meta" style="margin-top:.4rem">Az első (dobogós) képnél pipáld be alul, hogy mindig elöl jelenjen meg.</p>'
          + '</div><div id="g-thumbs"></div>';
        renderGalleryModePicker(sorted, customTitles);
        renderGalleryThumbs();
      });
    });
  }
  function renderGalleryModePicker(sorted, customTitles){
    var el = document.getElementById('g-mode-picker');
    if(!el) return;
    if(galleryMode==='tournament'){
      el.innerHTML = '<div class="field"><label>Verseny kiválasztása</label><select id="g-tid" onchange="MUB.pickGalleryTournament(this.value)">'
        + sorted.map(function(t){ return '<option value="'+t.id+'" '+(t.id===galleryPickTid?'selected':'')+'>'+esc(t.location_hu)+' ('+t.date+')</option>'; }).join('')
        + '</select></div>';
    } else {
      el.innerHTML = '<div class="field"><label>Album címe</label><input id="g-custom-title" list="g-title-suggest" value="'+esc(galleryCustomTitle)+'" oninput="MUB.setGalleryCustomTitle(this.value)" placeholder="pl. Évzáró vacsora"><datalist id="g-title-suggest">'
        + customTitles.map(function(ct){ return '<option value="'+esc(ct)+'">'; }).join('') + '</datalist></div>';
    }
  }
  function setGalleryMode(m){ galleryMode = m; renderAdminGallery(); }
  function setGalleryCustomTitle(v){ galleryCustomTitle = v; }
  function pickGalleryTournament(id){ galleryPickTid = id; renderGalleryThumbs(); }
  function currentGalleryFilter(photos){
    if(galleryMode==='tournament'){ return photos.filter(function(p){ return p.tournamentId===galleryPickTid; }); }
    var title = (galleryCustomTitle||'').trim();
    return title ? photos.filter(function(p){ return !p.tournamentId && p.customTitle===title; }) : [];
  }
  function renderGalleryThumbs(){
    invalidate('gallery');
    loadGallery(function(photos){
      var mine = currentGalleryFilter(photos).sort(function(a,b){ return (b.isPodium?1:0)-(a.isPodium?1:0); });
      document.getElementById('g-thumbs').innerHTML = '<div class="thumbgrid">' + mine.map(function(p){
        return '<div class="ph"><img src="'+esc(p.url)+'" loading="lazy">'
          + '<button class="rm" title="Törlés" onclick="MUB.deletePhoto(\''+p.id+'\',\''+esc(p.storagePath||'')+'\')">✕</button>'
          + '</div>';
      }).join('') + '</div>'
      + (mine.length ? '<div class="field" style="margin-top:.8rem"><label>Melyik a dobogós (első) kép?</label><select onchange="MUB.setPodium(this.value)"><option value="">— nincs kijelölve —</option>'
        + mine.map(function(p){ return '<option value="'+p.id+'" '+(p.isPodium?'selected':'')+'>'+p.id.slice(0,6)+'…'+(p.isPodium?' (jelenlegi)':'')+'</option>'; }).join('') + '</select></div>' : '');
    });
  }
  function uploadPhotos(){
    var files = document.getElementById('g-file').files;
    if(!files || !files.length) return;
    var extra;
    var folder;
    if(galleryMode==='tournament'){
      if(!galleryPickTid) return;
      extra = {tournamentId: galleryPickTid};
      folder = galleryPickTid;
    } else {
      var title = (galleryCustomTitle||'').trim();
      if(!title) return;
      extra = {customTitle: title};
      folder = 'album-'+title.replace(/[^a-zA-Z0-9]+/g,'-').toLowerCase();
    }
    var btn = document.getElementById('g-upload-btn');
    btn.disabled = true; btn.textContent = 'Feltöltés…';
    var tasks = Array.prototype.map.call(files, function(file){
      var path = 'gallery/'+folder+'/'+Date.now()+'-'+Math.random().toString(36).slice(2,8)+'-'+file.name;
      var ref = storage.ref().child(path);
      return ref.put(file).then(function(){ return ref.getDownloadURL(); }).then(function(url){
        var data = Object.assign({ url: url, storagePath: path, isPodium:false, createdAt: firebase.firestore.FieldValue.serverTimestamp() }, extra);
        return db.collection('gallery').add(data);
      });
    });
    Promise.all(tasks).then(function(){
      btn.disabled=false; btn.textContent='Feltöltés';
      document.getElementById('g-file').value = '';
      renderGalleryThumbs();
    }).catch(function(err){
      btn.disabled=false; btn.textContent='Feltöltés';
      alert('A feltöltés nem sikerült: ' + err.message);
    });
  }
  function setPodium(photoId){
    loadGallery(function(photos){
      var mine = currentGalleryFilter(photos);
      var batch = db.batch();
      mine.forEach(function(p){
        batch.set(db.collection('gallery').doc(p.id), {isPodium: p.id===photoId}, {merge:true});
      });
      batch.commit().then(function(){ invalidate('gallery'); renderGalleryThumbs(); });
    });
  }
  function deletePhoto(id, storagePath){
    if(!confirm('Biztosan törlöd ezt a képet?')) return;
    var p = db.collection('gallery').doc(id).delete();
    if(storagePath){ storage.ref().child(storagePath).delete().catch(function(){}); }
    p.then(function(){ invalidate('gallery'); renderGalleryThumbs(); });
  }

  /* --- admin: registrations --- */
  var regPickTid = '';
  function renderAdminRegistrations(){
    var body = document.getElementById('admin-body');
    loadTournaments(function(ts){
      var sorted = ts.slice().sort(byDateDesc);
      if(!regPickTid && sorted.length) regPickTid = sorted[0].id;
      body.innerHTML = '<div class="field noprint"><label>Verseny</label><select onchange="MUB.pickRegTournament(this.value)">'
        + sorted.map(function(t){ return '<option value="'+t.id+'" '+(t.id===regPickTid?'selected':'')+'>'+esc(t.location_hu)+' ('+t.date+')</option>'; }).join('')
        + '</select></div>'
        + '<div class="toolbar noprint"><div></div><div><button class="btn sm secondary" onclick="window.print()">Nyomtatás</button> <button class="btn sm" onclick="MUB.exportCsv()">CSV export</button></div></div>'
        + '<div id="reg-list"></div>';
      renderRegList();
    });
  }
  function pickRegTournament(id){ regPickTid = id; renderRegList(); }
  var lastRegList = [];
  function renderRegList(){
    db.collection('registrations').where('tournamentId','==',regPickTid).get().then(function(snap){
      var regs = []; snap.forEach(function(d){ regs.push(Object.assign({id:d.id}, d.data())); });
      regs.sort(function(a,b){ return (a.name||'').localeCompare(b.name||'', 'hu'); });
      lastRegList = regs;
      document.getElementById('reg-list').innerHTML = '<div class="table-wrap"><table class="list"><thead><tr><th>#</th><th>Név</th><th>Kód</th><th class="noprint">Jelen</th></tr></thead><tbody>'
        + regs.map(function(r,i){
          return '<tr><td class="num">'+(i+1)+'</td><td>'+esc(r.name)+'</td><td>'+esc(r.code||'')+'</td><td class="noprint"><span class="checkbox"></span></td></tr>';
        }).join('') + '</tbody></table></div>'
        + '<div class="meta" style="margin-top:.5rem">'+regs.length+' jelentkező</div>' || '<p class="meta">Még nincs jelentkező.</p>';
    });
  }
  function exportCsv(){
    var rows = [['Név','Kód']].concat(lastRegList.map(function(r){ return [r.name||'', r.code||'']; }));
    var csv = rows.map(function(r){ return r.map(function(v){ return '"'+String(v).replace(/"/g,'""')+'"'; }).join(','); }).join('\n');
    var blob = new Blob(['﻿'+csv], {type:'text/csv;charset=utf-8'});
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a'); a.href = url; a.download = 'jelentkezok-'+regPickTid+'.csv';
    document.body.appendChild(a); a.click(); a.remove(); URL.revokeObjectURL(url);
  }

  /* --- admin: players (codes) --- */
  function renderAdminPlayers(){
    var body = document.getElementById('admin-body');
    body.innerHTML = '<div class="card" style="margin-bottom:1.2rem"><h3 style="margin-bottom:.8rem">Új játékos</h3>'
      + '<div class="row2"><div class="field"><label>Kód</label><input id="p-code"></div><div class="field"><label>Név</label><input id="p-name"></div></div>'
      + '<div class="field"><label>NFC kártyakód (opcionális)</label><input id="p-nfc"></div>'
      + '<button class="btn sm" onclick="MUB.addPlayer()">Hozzáadás</button></div>'
      + '<div class="card" style="margin-bottom:1.2rem"><h3 style="margin-bottom:.6rem">Tömeges felvétel</h3>'
      + '<p class="meta" style="margin-bottom:.6rem">Az alap 100 fős játékoslista importálása egy kattintással (csak az még nem szereplő kódokat veszi fel).</p>'
      + '<button class="btn sm secondary" onclick="MUB.importDefaultRoster()">Alap lista importálása</button>'
      + '<div class="field" style="margin-top:1rem"><label>Vagy illessz be listát (soronként: sorszám, NFC kód, név – tabbal vagy több szóközzel elválasztva)</label><textarea id="p-paste" rows="4" placeholder="1	3046748439	Sárközi Ferenc"></textarea></div>'
      + '<button class="btn sm secondary" onclick="MUB.importPastedRoster()">Beillesztett lista importálása</button>'
      + '<p id="import-status" class="meta" style="margin-top:.5rem">'+esc(lastImportStatus)+'</p>'
      + '</div><div id="p-list"></div>';
    invalidate('players');
    loadPlayers(function(players){
      var sorted = players.slice().sort(function(a,b){ return (a.code||'').localeCompare(b.code||'', undefined, {numeric:true}); });
      document.getElementById('p-list').innerHTML = '<div class="table-wrap"><table class="list"><thead><tr><th>Kód</th><th>Név</th><th>NFC kód</th><th></th></tr></thead><tbody>'
        + sorted.map(function(p){ return '<tr><td class="num">'+esc(p.code)+'</td><td>'+esc(p.name)+'</td><td class="num">'+esc(p.nfcCode||'')+'</td><td><button class="btn sm danger" onclick="MUB.deletePlayer(\''+p.code+'\')">Törlés</button></td></tr>'; }).join('')
        + '</tbody></table></div>' || '<p class="meta">Még nincs felvett játékos.</p>';
    });
  }
  function addPlayer(){
    var code = document.getElementById('p-code').value.trim();
    var name = document.getElementById('p-name').value.trim();
    var nfc = document.getElementById('p-nfc').value.trim();
    if(!code || !name) return;
    var data = {name:name};
    if(nfc) data.nfcCode = nfc;
    db.collection('players').doc(code).set(data, {merge:true}).then(function(){ invalidate('players'); renderAdminPlayers(); });
  }
  function deletePlayer(code){
    if(!confirm('Biztosan törlöd?')) return;
    db.collection('players').doc(code).delete().then(function(){ invalidate('players'); renderAdminPlayers(); });
  }

