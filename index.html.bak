  var lastImportStatus = '';
  function importRosterRows(rows){
    lastImportStatus = 'Importálás…';
    var statusEl = document.getElementById('import-status');
    if(statusEl){ statusEl.textContent = lastImportStatus; }
    loadPlayers(function(existing){
      var existingCodes = {}; existing.forEach(function(p){ existingCodes[p.code]=true; });
      var toWrite = rows.filter(function(r){ return !existingCodes[String(r[0])]; });
      if(!toWrite.length){
        lastImportStatus = 'Nincs új játékos importálandó (mindegyik kód már fel van véve).';
        if(statusEl) statusEl.textContent = lastImportStatus;
        return;
      }
      var chunks = [];
      for(var i=0;i<toWrite.length;i+=400){ chunks.push(toWrite.slice(i,i+400)); }
      var p = Promise.resolve();
      chunks.forEach(function(chunk){
        p = p.then(function(){
          var batch = db.batch();
          chunk.forEach(function(r){
            var data = {name: String(r[2]||'').trim()};
            if(r[1]) data.nfcCode = String(r[1]).trim();
            batch.set(db.collection('players').doc(String(r[0])), data, {merge:true});
          });
          return batch.commit();
        });
      });
      p.then(function(){
        invalidate('players');
        lastImportStatus = toWrite.length + ' játékos importálva.';
        renderAdminPlayers();
      }).catch(function(err){
        lastImportStatus = 'Hiba: ' + err.message;
        if(statusEl) statusEl.textContent = lastImportStatus;
      });
    });
  }
  function importDefaultRoster(){ importRosterRows(PLAYER_ROSTER); }
  function importPastedRoster(){
    var text = document.getElementById('p-paste').value;
    var lines = text.split('\n').map(function(l){return l.trim();}).filter(Boolean);
    var rows = [];
    lines.forEach(function(line){
      var parts = line.split(/\t+|\s{2,}/).map(function(x){return x.trim();}).filter(Boolean);
      if(parts.length < 3){ parts = line.split(/\s+/); }
      if(parts.length < 3) return;
      var serial = parts[0];
      var nfc = parts[1];
      var name = parts.slice(2).join(' ');
      if(!name) return;
      rows.push([serial, nfc, name]);
    });
    if(!rows.length){
      lastImportStatus = 'Nem sikerült felismerni egyetlen sort sem.';
      var statusEl = document.getElementById('import-status');
      if(statusEl) statusEl.textContent = lastImportStatus;
      return;
    }
    importRosterRows(rows);
  }

  /* --- admin: downloads --- */
  function renderAdminDownloads(){
    var body = document.getElementById('admin-body');
    body.innerHTML = '<div class="card" style="margin-bottom:1.2rem"><h3 style="margin-bottom:.8rem">Új letöltés</h3>'
      + '<div class="row2"><div class="field"><label>Megnevezés</label><input id="d-label" placeholder="pl. Pontszámoló Excel 2026"></div><div class="field"><label>Link (Google Drive)</label><input id="d-url" placeholder="https://drive.google.com/..."></div></div>'
      + '<button class="btn sm" onclick="MUB.addDownload()">Hozzáadás</button></div><div id="d-list"></div>';
    invalidate('downloads');
    loadDownloads(function(items){
      document.getElementById('d-list').innerHTML = items.map(function(d){
        return '<div class="card" style="margin-bottom:.5rem;display:flex;justify-content:space-between;align-items:center;gap:.6rem"><div><strong>'+esc(d.label)+'</strong><div class="meta">'+esc(d.url)+'</div></div><button class="btn sm danger" onclick="MUB.deleteDownload(\''+d.id+'\')">Törlés</button></div>';
      }).join('') || '<p class="meta">Még nincs letöltés felvéve.</p>';
    });
  }
  function addDownload(){
    var label = document.getElementById('d-label').value.trim();
    var url = document.getElementById('d-url').value.trim();
    if(!label || !url) return;
    db.collection('downloads').add({label:label, url:url}).then(function(){ invalidate('downloads'); renderAdminDownloads(); });
  }
  function deleteDownload(id){
    if(!confirm('Biztosan törlöd?')) return;
    db.collection('downloads').doc(id).delete().then(function(){ invalidate('downloads'); renderAdminDownloads(); });
  }

  /* ---------- auth wiring + boot ---------- */
  auth.onAuthStateChanged(function(user){
    currentUser = user; isAdmin = !!user;
    render();
  });

  window.MUB = {
    toggleLang: toggleLang, textSize: textSize, selectTournament: selectTournament, lookupCode: lookupCode, resetRegForm: resetRegForm, cancelRegistration: cancelRegistration,
    login: login, logout: logout, forgotPassword: forgotPassword, setAdminTab: setAdminTab,
    editTournament: editTournament, saveTournament: saveTournament, deleteTournament: deleteTournament,
    editSeason: editSeason, saveSeason: saveSeason, deleteSeason: deleteSeason,
    addNews: addNews, deleteNews: deleteNews,
    setGalleryMode: setGalleryMode, setGalleryCustomTitle: setGalleryCustomTitle,
    pickGalleryTournament: pickGalleryTournament, uploadPhotos: uploadPhotos, setPodium: setPodium, deletePhoto: deletePhoto,
    pickRegTournament: pickRegTournament, exportCsv: exportCsv,
    addPlayer: addPlayer, deletePlayer: deletePlayer, importDefaultRoster: importDefaultRoster, importPastedRoster: importPastedRoster,
    addDownload: addDownload, deleteDownload: deleteDownload
  };

  render();
})();
</script>
</body>
</html>
